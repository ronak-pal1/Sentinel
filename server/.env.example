NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/sentinel
CLIENT_ORIGIN=http://localhost:5173

# TrueForge agent harness (local default: npx @truefoundry/trueforge)
TRUEFORGE_BASE_URL=http://localhost:8790
# TRUEFORGE_TOKEN=
TRUEFORGE_AGENT_NAME=sentinel
TRUEFORGE_MODEL=anthropic/claude-sonnet-4-6

# TrueForge bootstrap — run: npm run setup:trueforge (TrueForge must be running)
DAYTONA_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# 32-byte key as 64 hex chars — generate with: openssl rand -hex 32
SETTINGS_ENCRYPTION_KEY=74801a3e2adff8e3b6632f702b693038128067c79d7f6cc80a6757c8a206626e

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# Public URL for webhook endpoints (shown to users)
SERVER_PUBLIC_URL=http://localhost:3000
