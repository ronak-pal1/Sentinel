{
  "name": "sentinel-incident-cli",
  "version": "1.0.0",
  "description": "CLI tool to trigger Sentinel webhook incidents for hackathon demos",
  "type": "module",
  "bin": {
    "sentinel-trigger": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["sentinel", "incident", "webhook", "cli"],
  "license": "ISC",
  "dependencies": {
    "@inquirer/prompts": "^7.5.0",
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
